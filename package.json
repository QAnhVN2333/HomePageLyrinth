{
  "name": "my-homepage-lyrinth",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:tunnel": "cloudflared tunnel --config ./cloudflared-quick.yml --no-autoupdate run lyrinth_test",
    "build": "npm run build:web",
    "build:web": "npm run build --workspace apps/web",
    "lint": "npm run lint:web",
    "lint:web": "npm run lint --workspace apps/web",
    "test:api": "npm run smoke:test --workspace apps/api"
  }
}
